---
import { Icon } from 'astro-icon/components';
import SectionHeading from '../ui/SectionHeading.astro';
import { contato, whatsapp } from '../../data/content.ts';

const waHref = `https://wa.me/${whatsapp.phone}?text=${encodeURIComponent(whatsapp.message)}`;

const waDisplay = (() => {
  const m = whatsapp.phone.match(/^55(\d{2})(\d{4,5})(\d{4})$/);
  return m ? `+55 (${m[1]}) ${m[2]}-${m[3]}` : whatsapp.phone;
})();

const channels = [
  {
    id: 'email',
    label: contato.email.label,
    value: contato.email.value,
    href: contato.email.href,
    external: false,
    kind: 'email' as const
  },
  {
    id: 'whatsapp',
    label: contato.whatsapp.label,
    value: waDisplay,
    href: waHref,
    external: true,
    kind: 'whatsapp' as const
  }
];
---

<section id="contato" class="pb-[var(--spacing-section)]">
  <div class="container-page">
    <div
      class="grid items-end gap-10 border-t border-border pt-14 sm:gap-12 sm:pt-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-16 lg:pt-20"
    >
      <SectionHeading
        eyebrow={contato.eyebrow}
        eyebrowIcon={contato.eyebrowIcon}
        title={contato.title}
      >
        {contato.lead}
      </SectionHeading>

      <ul class="reveal flex flex-col border-t border-border lg:border-t-0 lg:border-l lg:pl-16" style="--i:2" data-reveal>
        {
          channels.map((c, i) => (
            <li class:list={[i > 0 && 'border-t border-border']}>
              <a
                href={c.href}
                {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="group flex min-h-14 items-center gap-4 py-5 transition-colors duration-300 sm:gap-5 sm:py-6"
              >
                <span
                  class:list={[
                    'grid h-12 w-12 shrink-0 place-items-center rounded-pill transition-[transform,background-color,color] duration-300 ease-[var(--ease-out)] group-hover:-translate-y-0.5 sm:h-13 sm:w-13',
                    c.kind === 'whatsapp'
                      ? 'bg-[#25D366]/12 text-[#25D366] group-hover:bg-[#25D366] group-hover:text-white'
                      : 'bg-violet-100 text-violet-700 group-hover:bg-violet-600 group-hover:text-white'
                  ]}
                >
                  {c.kind === 'whatsapp' ? (
                    <svg
                      viewBox="0 0 24 24"
                      class="h-5 w-5 sm:h-[1.35rem] sm:w-[1.35rem]"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                    </svg>
                  ) : (
                    <Icon name="hugeicons:mail-01" class="h-5 w-5 sm:h-[1.35rem] sm:w-[1.35rem]" />
                  )}
                </span>

                <span class="min-w-0 flex-1">
                  <span class="micro block text-fg-subtle">{c.label}</span>
                  <span
                    class:list={[
                      'mt-1.5 block truncate font-display text-[1.0625rem] font-medium tracking-[-0.026em] text-fg transition-colors duration-300 sm:text-[1.125rem]',
                      c.kind === 'whatsapp' ? 'group-hover:text-[#1EBE57]' : 'group-hover:text-violet-800'
                    ]}
                  >
                    {c.value}
                  </span>
                </span>

                <svg
                  viewBox="0 0 16 16"
                  class:list={[
                    'h-4 w-4 shrink-0 text-fg-subtle transition-[transform,color] duration-300 ease-[var(--ease-out)] group-hover:translate-x-1',
                    c.kind === 'whatsapp' ? 'group-hover:text-[#1EBE57]' : 'group-hover:text-violet-700'
                  ]}
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
