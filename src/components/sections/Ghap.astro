---
import { Image } from 'astro:assets';
import { ghap } from '../../data/content.ts';
import ghapMark from '../../assets/photos/ghap.png';
---

<section class="pb-[var(--spacing-section)]" aria-labelledby="ghap-heading">
  <div class="container-page">
    <h2
      id="ghap-heading"
      class="micro reveal border-b border-border pb-4 text-fg-subtle"
      data-reveal
    >
      {ghap.eyebrow}
    </h2>

    <div
      class="mt-10 grid gap-10 sm:mt-12 lg:mt-14 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-end lg:gap-16"
    >
      <a
        href={ghap.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group reveal inline-flex max-w-full"
        style="--i:1"
        data-reveal
      >
        <Image
          src={ghapMark}
          alt="GHAP"
          widths={[480, 720, 960, 1400]}
          sizes="(min-width: 64rem) 28rem, (min-width: 40rem) 24rem, min(100vw - 2.5rem, 20rem)"
          loading="lazy"
          decoding="async"
          class="h-auto w-[min(100%,20rem)] origin-left transition-[transform,opacity] duration-300 ease-[var(--ease-out)] group-hover:-translate-y-0.5 group-hover:opacity-80 sm:w-[24rem] lg:w-[28rem]"
        />
      </a>

      <div
        class="reveal flex max-w-md flex-col lg:border-l lg:border-border lg:pl-16"
        style="--i:2"
        data-reveal
      >
        <p class="text-h3 text-fg">{ghap.tagline}</p>
        <a
          href={ghap.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group mt-6 inline-flex min-h-11 w-fit items-center gap-2 text-[0.9375rem] font-medium text-fg underline decoration-border-strong underline-offset-[6px] transition-[color,text-decoration-color] duration-300 hover:decoration-fg"
        >
          <span>{ghap.cta}</span>
          <svg
            viewBox="0 0 16 16"
            class="h-4 w-4 shrink-0 transition-transform duration-300 ease-[var(--ease-out)] group-hover:translate-x-1"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
